{
  "name": "tomato-clock",
  "version": "7.6.2",
  "description": "Tomato Clock is a simple browser extension for managing your productivity.",
  "main": "src/background/background.ts",
  "scripts": {
    "lint": "eslint src",
    "lint-fix": "eslint --fix src",
    "lint:ext": "web-ext lint --source-dir ./dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "webpack --mode=production && web-ext build --source-dir ./dist --artifacts-dir ./dist-zip --overwrite-dest",
    "watch": "webpack --watch",
    "start": "web-ext run --source-dir ./dist",
    "build:firefox": "npm run build",
    "watch:firefox": "npm run watch",
    "start:firefox": "npm run start",
    "build:chrome": "TARGET_BROWSER=chrome npm run build",
    "watch:chrome": "TARGET_BROWSER=chrome webpack --watch",
    "start:chrome": "web-ext run -t chromium --source-dir ./dist",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/samueljun/tomato-clock.git"
  },
  "keywords": [
    "WebExtension"
  ],
  "author": "Samuel Jun",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/samueljun/tomato-clock/issues"
  },
  "homepage": "https://github.com/samueljun/tomato-clock#readme",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "core-js": "^3.47.0",
    "daterangepicker": "^3.1.0",
    "jquery": "^3.6.0",
    "lodash": "^4.18.1",
    "moment": "^2.29.4",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@types/bootstrap": "^5.2.10",
    "@types/chrome": "^0.1.40",
    "@types/daterangepicker": "^3.1.8",
    "@types/jquery": "^4.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.0",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitest/coverage-v8": "^4.1.5",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "html-webpack-plugin": "^5.5.3",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.2.7",
    "prettier": "3.7.4",
    "style-loader": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5",
    "web-ext": "^10.0.0",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1"
  },
  "engines": {
    "node": "24"
  },
  "browserslist": [
    "defaults"
  ]
}
